      "dataset_id": "mart_exec.executive_scorecard_daily",
      "schema": "mart_exec",
      "table": "executive_scorecard_daily",
      "owner_team": "Enterprise Analytics",
      "grain": "One row per date, business area, and executive metric.",
      "time_column": "scorecard_date",
      "certification": "gold",
      "metrics": [
        {"name": "Metric Value", "sql": "SUM(metric_value)", "format": ",.2f"},
        {"name": "Target Value", "sql": "SUM(target_value)", "format": ",.2f"},
        {"name": "Variance To Target", "sql": "SUM(metric_value) - SUM(target_value)", "format": ",.2f"},
        {"name": "Metric Count", "sql": "COUNT(*)", "format": ",d"}
      ],
      "dimensions": ["business_area", "metric_name", "metric_unit", "status", "owner_team"]
    },
